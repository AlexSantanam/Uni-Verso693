rules_version = '2';

// UNIVERSO693 · Starter Restaurante QR — Reglas de seguridad de Firestore
// Pega este archivo completo en: Firebase Console -> Firestore Database -> Reglas.
//
// Modelo:
//   restaurantes/{restaurantId}                     -> estado del local (abierto, promo)
//   restaurantes/{restaurantId}/categorias/{catId}   -> categorías de la carta
//   restaurantes/{restaurantId}/platos/{platoId}     -> platos, precios y stock
//   restaurantes/{restaurantId}/pedidos/{pedidoId}   -> comandas entrantes
//   restaurantes/{restaurantId}/clientes/{telefono}  -> CRM (ficha por cliente)
//
// Regla general: la CARTA (restaurante, categorías, platos) es pública para
// LEER (cualquiera que abra index.html debe poder ver el menú sin iniciar
// sesión) pero solo el personal autenticado (dueño/recepción/cocina) puede
// EDITARLA desde panel.html o cocina.html.
//
// Los PEDIDOS los puede CREAR cualquier cliente (al confirmar su comanda),
// pero solo el personal autenticado puede LEERLOS o cambiarles el estado
// (nuevo -> cocina -> listo -> despachado), para que nadie externo pueda
// ver o manipular las comandas de otros clientes del local.
//
// Los CLIENTES (CRM) se crean/actualizan automáticamente desde index.html
// al confirmar un pedido con delivery (misma lógica que los pedidos), pero
// solo el personal autenticado puede LEER la lista completa de clientes
// desde panel.html — así nadie externo puede exportar la base de contactos.

service cloud.firestore {
  match /databases/{database}/documents {

    match /restaurantes/{restaurantId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /categorias/{catId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /platos/{platoId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /pedidos/{pedidoId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null;
      }

      match /clientes/{telefono} {
        allow create, update: if true;
        allow read, delete: if request.auth != null;
      }

      // Los códigos de descuento son públicos para LEER (el cliente debe poder
      // validar un código al pagar) y para actualizar el contador de usos al
      // confirmar un pedido, pero solo el personal autenticado puede crearlos
      // o eliminarlos desde panel.html.
      match /descuentos/{codigo} {
        allow read, update: if true;
        allow create, delete: if request.auth != null;
      }
    }
  }
}
