# ANTHROPIC_API_KEY: Required by the live AI agent chat demo on the homepage.
# Get one at https://console.anthropic.com/settings/keys
#
# The frontend always calls /api/chat, backed by two equivalent implementations:
#   - netlify/functions/chat.mts (Netlify Functions, shares src/server/chatHandler.ts)
#   - api/chat.ts (Vercel Node.js Function, self-contained — see comment in that file)
# On Netlify a redirect in netlify.toml forwards /api/chat to the Netlify Function;
# on Vercel it's served natively.
#
# - Netlify: set this in Site settings > Environment variables.
# - Vercel: set this in Project settings > Environment Variables.
# - Local dev: copy this file to .env and fill in your key, then run `netlify dev`
#   (requires the Netlify CLI) so the function and the Vite app run together.
ANTHROPIC_API_KEY="your-anthropic-api-key"

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN: Required for rate limiting
# on /api/chat (8 requests/min per IP, shared across all function instances).
# Create a free Redis database at https://console.upstash.com/ and copy both
# values from its "REST API" tab. Set these the same way as ANTHROPIC_API_KEY
# above, on both Netlify and Vercel.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# RESEND_API_KEY / CONTACT_NOTIFICATION_EMAIL: Required by api/contact.ts, which
# sends a real email when someone submits the contact form (previously it only
# faked success client-side). Create a free account and API key at
# https://resend.com/ — no domain verification needed to get started, it sends
# from Resend's shared "onboarding@resend.dev" sender.
# CONTACT_NOTIFICATION_EMAIL is where each new lead notification is sent (your
# own inbox). Set both the same way as the vars above.
RESEND_API_KEY="your-resend-api-key"
CONTACT_NOTIFICATION_EMAIL="you@example.com"
