# ANTHROPIC_API_KEY: Required by netlify/functions/chat.mts for the live AI agent
# chat demo on the homepage. Get one at https://console.anthropic.com/settings/keys
#
# - Production: set this in Netlify's Site settings > Environment variables.
# - Local dev: copy this file to .env and fill in your key, then run `netlify dev`
#   (requires the Netlify CLI) so the function and the Vite app run together.
ANTHROPIC_API_KEY="your-anthropic-api-key"
