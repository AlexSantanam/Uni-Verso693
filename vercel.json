{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "uni-verso693.vercel.app"
        }
      ],
      "destination": "https://universo693.com/$1",
      "permanent": true
    },
    {
      "source": "/audit",
      "destination": "/audit-693",
      "permanent": true
    },
    {
      "source": "/ebs",
      "destination": "/diagnostico-ia",
      "permanent": true
    }
  ],
  "functions": {
    "api/audit.ts": {
      "maxDuration": 60
    },
    "api/pro.ts": {
      "maxDuration": 300
    },
    "api/admin.ts": {
      "maxDuration": 300
    },
    "api/whatsapp.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; connect-src 'self' https: wss:; font-src 'self' https: data:;"
        }
      ]
    },
    {
      "source": "/interno",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ebs/:token",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ebs/:token",
      "destination": "/ebs/_"
    }
  ]
}
