{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "uni-verso693.vercel.app"
        }
      ],
      "destination": "https://universo693.com/$1",
      "permanent": true
    },
    {
      "source": "/audit",
      "destination": "/audit-693",
      "permanent": true
    },
    {
      "source": "/ebs",
      "destination": "/diagnostico-ia",
      "permanent": true
    }
  ],
  "functions": {
    "api/audit.ts": {
      "maxDuration": 60
    },
    "api/pro.ts": {
      "maxDuration": 300
    },
    "api/admin.ts": {
      "maxDuration": 300
    },
    "api/whatsapp.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/interno",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ebs/:token",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ebs/:token",
      "destination": "/ebs/_"
    }
  ]
}
